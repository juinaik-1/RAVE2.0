PORT=3001
# The public origin of this API. It builds the signed stream URLs, so it must
# be the address the browser can reach. In production it must be https and
# must not be localhost.
PUBLIC_BASE_URL=http://localhost:3001
# The exact origins of the frontend. No wildcards.
FRONTEND_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
ALLOWED_EMAILS=person@example.com,another@example.com

# Generate three independent secrets; see README.md for PowerShell commands.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
STREAM_SECRET=replace-with-a-different-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

DATA_DIR=./server/data
DOWNLOAD_DIR=./server/downloads
MAX_SOURCE_GB=5
MAX_QUEUE_SIZE=3

# How long a converted video is kept and served, in hours. The file is deleted
# when this runs out, and the countdown in the room shows the same time.
# On a small disk lower this: it is the main thing that decides how much disk
# the converted videos use.
FILE_TTL_HOURS=36

# Threads ffmpeg may use. The API proxies video streams while a conversion
# runs, so ffmpeg must not take every core. 1-8, default 2.
FFMPEG_THREADS=2

# Free space the disk must have left before a new conversion is accepted, in
# GB. This is a tripwire, not a reservation: the per job check still insists
# on room for the source and the output together. Default 1.
MIN_FREE_DISK_GB=1

# How long a leftover file is kept before the hourly cleanup removes it. A file
# that a live stream still serves is never removed. Defaults to FILE_TTL_HOURS,
# so one number decides when a converted video goes.
# ORPHAN_FILE_TTL_HOURS=36

# Requests one client address may make per minute. The media route has its own
# and much larger budget, because it streams bytes rather than API calls.
# API_RATE_LIMIT_PER_MIN=120
# AUTH_RATE_LIMIT_PER_MIN=20
# DRIVE_RATE_LIMIT_PER_MIN=30
# JOBS_RATE_LIMIT_PER_MIN=20
# MEDIA_RATE_LIMIT_PER_MIN=600
